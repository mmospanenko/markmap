{
  "name": "markmap",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite playground",
    "build": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm clean && pnpm build:types && pnpm build:js && pnpm test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "check:trace": "node scripts/check-trace.mjs",
    "verify": "pnpm check:trace && pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm build:types && pnpm build:js && pnpm test:coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "pnpm -r clean",
    "build:types": "tsc -b",
    "build:js": "pnpm -r build:js",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish --no-git-tag"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
